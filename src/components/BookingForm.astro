---
// Booking form. Posts to "Form endpoint" from Site settings when set, otherwise to Netlify Forms.
// If neither accepts it, the visitor's mail app opens with the request drafted to the recipient email.
import ScopeForm from './ScopeForm.astro';
import { site, pages, phoneHref, fmt } from '../lib/content.js';
const home = pages.home;
---

<section class="section booking" id="book">
  <div class="wrap">
    <div class="section-head center">
      <span class="eyebrow">Book a call</span>
      <h2 set:html={fmt(home.bookingTitle)} />
    </div>
    <div class="booking-panel">
    <div class="booking-grid">
      <div class="booking-copy">
        <h3>Schedule a free scoping call</h3>
        <p>{home.bookingIntro}</p>
        <ul class="ticks">{home.bookingPoints.map((p) => <li>{p}</li>)}</ul>
        <dl class="contact-list">
          <div><dt>Mail</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div><dt>Call</dt><dd><a href={`tel:${phoneHref}`}>{site.phone}</a></dd></div>
          {site.offices.map((o) => <div><dt>{o.country === 'Pakistan' ? 'PK' : 'US'}</dt><dd>{o.address}</dd></div>)}
        </dl>
      </div>
      <ScopeForm />
    </div>
    </div>
  </div>
</section>
