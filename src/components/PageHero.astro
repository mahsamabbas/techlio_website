---
import Diagram from './Diagram.astro';
import { cta } from '../lib/content.js';
const { back, kicker, title, intro, primaryLabel = cta.label, secondary, diagram, caption } = Astro.props;
---

<section class="page-hero">
  <div class="wrap">
    {back && <a class="back" href={back.href}>Back to {back.label}</a>}
    {kicker && <p class="kicker">{kicker}</p>}
    <h1>{title}</h1>
    <p class="lede">{intro}</p>
    <div class="actions">
      <a class="btn btn-primary" href={cta.href}>{primaryLabel}</a>
      {secondary && <a class="btn btn-ghost" href={secondary.href}>{secondary.label}</a>}
    </div>
    <slot />
    {diagram && <Diagram id={diagram} caption={caption} />}
  </div>
</section>
