---
import { site, cta } from '../lib/content.js';
const { title, text } = Astro.props;
---

<section class="closing">
  <div class="wrap closing-grid">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="closing-actions">
      <a class="btn btn-primary" href={cta.href}>{cta.label}</a>
      <p class="fine">{site.responsePromise}</p>
    </div>
  </div>
</section>
