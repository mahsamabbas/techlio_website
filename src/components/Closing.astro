---
import { site, cta, fmt } from '../lib/content.js';
const { title, text } = Astro.props;
---

<section class="closing">
  <div class="wrap">
    <div class="cta-banner">
      <div>
        <h2 set:html={fmt(title)} />
        <p>{text}</p>
      </div>
      <div>
        <a class="btn btn-light" href={cta.href}>{cta.label}</a>
        <p class="fine">{site.responsePromise}</p>
      </div>
    </div>
  </div>
</section>
