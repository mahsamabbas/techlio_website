---
import { site, services, offers, nav, phoneHref } from '../lib/content.js';
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label={`${site.name} home`}>
        <img src="/logo.png" width="133" height="34" alt={site.name} />
      </a>
      <p>{site.tagline}</p>
    </div>
    <div>
      <h2 class="footer-h">Services</h2>
      <ul>
        {services.map((s) => <li><a href={`/${s.slug}/`}>{s.short}</a></li>)}
        {offers.map((o) => <li><a href={`/${o.slug}/`}>{o.title}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="footer-h">Company</h2>
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/technologies/">Technologies</a></li>
        <li><a href={site.careersUrl}>Careers</a></li>
        <li><a href="/contact/#book">Book a call</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer-h">Contact</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={`tel:${phoneHref}`}>{site.phone}</a></li>
        <li><a href={site.linkedin} rel="noopener">LinkedIn</a></li>
        {(site.clutch || site.google) && (
          <li>
            {site.clutch && <a href={site.clutch} target="_blank" rel="noopener">Clutch</a>}
            {site.clutch && site.google && ' / '}
            {site.google && <a href={site.google} target="_blank" rel="noopener">Google Business Profile</a>}
          </li>
        )}
      </ul>
      {site.offices.map((o) => <address><strong>{o.country}</strong>{o.address}</address>)}
    </div>
  </div>
  <div class="wrap footer-legal">
    <span>{site.name} {new Date().getFullYear()} All Rights Reserved</span>
    <span><a href={site.termsUrl}>Terms of use</a><a href={site.privacyUrl}>Privacy Policy</a></span>
  </div>
</footer>
