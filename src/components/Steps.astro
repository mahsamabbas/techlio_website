---
// Ordered steps, shown as a vertical timeline.
const { items = [] } = Astro.props;
---

<ol class="timeline">
  {
    items.map((it) => (
      <li>
        <div>
          {it.when && <span class="step-when">{it.when}</span>}
          <h3>{it.title}</h3>
          <p>{it.text}</p>
          {it.list && it.list.length > 0 && <ul class="ticks">{it.list.map((l) => <li>{l}</li>)}</ul>}
        </div>
      </li>
    ))
  }
</ol>
