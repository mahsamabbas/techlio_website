---
// Proof badges, plus client reviews when any are entered in Site settings.
import { site, pages } from '../lib/content.js';
const reviews = site.reviews || [];
---

<section class="section reviews">
  <div class="wrap">
    <div class="section-head">
      <h2>{pages.home.proofTitle}</h2>
      <p>{pages.home.proofIntro}</p>
    </div>
    <div class="badges">
      {site.proof.map((p) => <div class="badge-card"><strong>{p.value}</strong><span>{p.label}</span></div>)}
    </div>
    {
      reviews.length > 0 && (
        <div class="review-grid">
          {reviews.map((r) => (
            <figure class="review">
              <blockquote>{r.quote}</blockquote>
              <figcaption>
                {r.name}, {r.role}, {r.company}
                <span>{r.source}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }
  </div>
</section>
