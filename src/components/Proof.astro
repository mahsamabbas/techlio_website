---
// Results banner joined to a white panel with review profiles and client reviews.
import { site, pages } from '../lib/content.js';
const reviews = site.reviews || [];
const profiles = [
  site.clutch && { name: 'Clutch', note: 'Verified client reviews', action: 'Read our reviews', href: site.clutch, logo: site.clutchLogo, icon: 'M12 3.5l2.6 5.3 5.9.9-4.25 4.1 1 5.8L12 16.9l-5.25 2.7 1-5.8L3.5 9.7l5.9-.9z' },
  site.google && { name: 'Google', note: 'Business profile', action: 'See our profile', href: site.google, logo: site.googleLogo, icon: 'M12 21s-6.5-5.4-6.5-10.5a6.5 6.5 0 0 1 13 0C18.5 15.6 12 21 12 21zM12 8a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z' },
  site.linkedin && { name: 'LinkedIn', note: 'Team and company updates', action: 'Follow Techlio', href: site.linkedin, logo: site.linkedinLogo, icon: 'M8.5 4a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM3 20a5.5 5.5 0 0 1 11 0M16 5.5a2.5 2.5 0 1 1 0 5M17 14.2a4.5 4.5 0 0 1 4 5.8' },
].filter(Boolean);
---

<section class="proof">
  <div class="wrap">
    <div class="proof-banner">
      <h2>{pages.home.proofTitle}</h2>
      <p>{pages.home.proofIntro}</p>
      <div class="badges">
        {site.proof.map((p) => <div class="badge-card"><strong>{p.value}</strong><span>{p.label}</span></div>)}
      </div>
    </div>
    <div class="proof-panel">
      {
        profiles.length > 0 && (
          <ul class="platforms">
            {profiles.map((p) => (
              <li>
                <a href={p.href} target="_blank" rel="noopener">
                  {p.logo
                    ? <span class="platform-logo"><img src={p.logo} alt="" /></span>
                    : <span class="platform-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={p.icon} /></svg></span>}
                  <span class="platform-text"><strong>{p.name}</strong><span>{p.note}</span></span>
                  <span class="platform-go">{p.action}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
      {
        reviews.length > 0 && (
          <>
            <div class="proof-head">
              <h3>What clients say about working with {site.name}</h3>
              {site.clutch && <a class="more" href={site.clutch} target="_blank" rel="noopener">See reviews on Clutch</a>}
            </div>
            <div class="review-grid">
              {reviews.map((r) => (
                <figure class="review">
                  <blockquote>{r.quote}</blockquote>
                  <figcaption>
                    <strong>{r.name}</strong>
                    {r.role}, {r.company}
                    <span>{r.source}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </>
        )
      }
    </div>
  </div>
</section>
