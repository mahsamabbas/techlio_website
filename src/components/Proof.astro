---
// Results banner, plus client reviews when any are entered in Site settings.
import { site, pages } from '../lib/content.js';
const reviews = site.reviews || [];
---

<section class="proof">
  <div class="wrap">
    <div class="proof-banner">
      <h2>{pages.home.proofTitle}</h2>
      <p>{pages.home.proofIntro}</p>
      <div class="badges">
        {site.proof.map((p) => <div class="badge-card"><strong>{p.value}</strong><span>{p.label}</span></div>)}
      </div>
    </div>
    {
      reviews.length > 0 && (
        <div class="review-grid">
          {reviews.map((r) => (
            <figure class="review">
              <blockquote>{r.quote}</blockquote>
              <figcaption>
                <strong>{r.name}</strong>
                {r.role}, {r.company}
                <span>{r.source}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }
    {
      (site.clutch || site.google) && (
        <div class="profiles">
          <span>Check us independently</span>
          {site.clutch && <a class="profile-link" href={site.clutch} target="_blank" rel="noopener">Techlio on Clutch</a>}
          {site.google && <a class="profile-link" href={site.google} target="_blank" rel="noopener">Techlio on Google</a>}
        </div>
      )
    }
  </div>
</section>
