---
// Small line icons for cards. Falls back to a spark for unknown names.
const { name = 'spark' } = Astro.props;
const paths = {
  'ai-workflow-automation': 'M4 6h6v4H4zM14 14h6v4h-6zM10 8h4a2 2 0 0 1 2 2v4',
  'n8n-ai-automation': 'M13 3 5 13h6l-1 8 8-10h-6z',
  'ai-agents': 'M7 8h10a3 3 0 0 1 3 3v4a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-4a3 3 0 0 1 3-3zM12 8V4M9 13h.01M15 13h.01',
  'product-development': 'm8 8-4 4 4 4M16 8l4 4-4 4M13 6l-2 12',
  cybersecurity: 'M12 3 5 6v6c0 4 3 7 7 9 4-2 7-5 7-9V6zM9 12l2 2 4-4',
  'cloud-devops': 'M7 18a4 4 0 0 1-.5-8 5.5 5.5 0 0 1 10.6 1.2A3.5 3.5 0 0 1 17 18z',
  'ai-consulting': 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM15.5 8.5l-2 5-5 2 2-5z',
  spark: 'M12 3v6M12 15v6M3 12h6M15 12h6',
};
---

<span class="icon-chip" aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    <path d={paths[name] || paths.spark}></path>
  </svg>
</span>
