---
// Mount point for an interactive pipeline diagram (public/js/pipeline.js renders it from public/js/diagrams.js).
// compact: narrow vertical layout for use beside hero text.
const { id, caption = '', autorun = false, compact = false } = Astro.props;
---

<figure class="pipe" data-diagram={id} data-autorun={autorun ? '' : undefined} data-compact={compact ? '' : undefined}>
  <noscript><p class="pipe-noscript">This diagram is interactive and needs JavaScript. {caption}</p></noscript>
  {caption && <figcaption class="sr-only">{caption}</figcaption>}
</figure>
