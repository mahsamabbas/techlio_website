---
import { pickCases, initials } from '../lib/content.js';
const { slugs = [] } = Astro.props;
const items = pickCases(slugs);
---

<div class={`case-cards case-cards-${items.length}`}>
  {
    items.map((c) => (
      <article class="case-card">
        <div class="case-card-head">
          <span class="tile" aria-hidden="true">{initials(c.name)}</span>
          <div>
            <p class="case-tag">{c.industry}</p>
            <h3><a href={`/case-studies/${c.slug}/`}>{c.name}</a></h3>
          </div>
        </div>
        <p>{c.headline}.</p>
        <ul class="chips">{(c.services || c.categories).map((t) => <li>{t}</li>)}</ul>
        <span class="more">Read case study</span>
      </article>
    ))
  }
</div>
