---
import { pickCases } from '../lib/content.js';
const { slugs = [] } = Astro.props;
const items = pickCases(slugs);
---

<div class={`case-cards case-cards-${items.length}`}>
  {
    items.map((c) => (
      <article class="case-card">
        <div class="case-card-visual">
          {c.logo ? <img src={c.logo} alt="" width={c.logoWidth} height={c.logoHeight} /> : <span aria-hidden="true">{c.name}</span>}
        </div>
        <div class="case-card-body">
          <p class="case-tag">{c.industry}</p>
          <h3><a href={`/case-studies/${c.slug}/`}>{c.headline}</a></h3>
          {c.metrics && c.metrics[0] && <p class="case-card-metric"><strong>{c.metrics[0].value}</strong><span>{c.metrics[0].label}</span></p>}
          <span class="more">Read the {c.name} case study</span>
        </div>
      </article>
    ))
  }
</div>
