---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import PageHero from '../../components/PageHero.astro';
import Closing from '../../components/Closing.astro';
import { industries, services, offers, pickCases, faqSchema, breadcrumbSchema, site } from '../../lib/content.js';

export function getStaticPaths() {
  return industries.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props;
const linked = (t.services || []).map((s) => [...services, ...offers].find((e) => e.slug === s)).filter(Boolean);
// Everything shown about a client comes from its case study, so the two can never disagree.
const work = pickCases(t.cases);
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: t.metaTitle || t.name, description: t.description, url: new URL(`/industries/${t.slug}/`, site.url).href, provider: { '@id': `${site.url}/#organization` }, areaServed: ['US', 'GB', 'Europe'] },
  ...faqSchema(t.faqs),
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Industries', path: '/industries/' }, { name: t.name, path: `/industries/${t.slug}/` }]),
];
---

<Base title={t.metaTitle || t.name} description={t.description} schema={schema}>
  <PageHero kicker="Industry" back={{ href: '/industries/', label: 'All industries' }} title={t.h1} intro={t.description} secondary={{ href: '/case-studies/', label: 'See shipped work' }} />
  <section class="answer-band">
    <div class="wrap"><div class="article-answer"><strong>In short</strong><p>{t.answer}</p></div></div>
  </section>
  {
    t.problems && t.problems.length > 0 && (
      <Section eyebrow="Where teams get stuck" title={`Problems we are asked to solve in *${t.name.toLowerCase()}*`}>
        <ul class="ticks ticks-grid ticks-2">{t.problems.map((x) => <li>{x}</li>)}</ul>
      </Section>
    )
  }
  {
    work.length > 0 && (
      <Section tint eyebrow="Client work" title="What we *built*">
        <div class="industry-work">
          {work.map((c) => (
            <article class="industry-case">
              <header>
                {c.logo ? <span class="tile has-logo"><img src={c.logo} alt={`${c.name} logo`} width={c.logoWidth} height={c.logoHeight} loading="lazy" /></span> : <span class="tile" aria-hidden="true">{c.name}</span>}
                <div>
                  <p class="tech-badge">{c.name} · {c.industry}</p>
                  <h3>{c.headline}</h3>
                </div>
              </header>
              <p>{c.overview}</p>
              {c.solutions && c.solutions.length > 0 && <ul class="chips">{c.solutions.map((x) => <li>{x.title || x}</li>)}</ul>}
              {c.metrics && c.metrics.length > 0 && (
                <dl class="industry-metrics">{c.metrics.slice(0, 3).map((m) => <div><dt>{m.value}</dt><dd>{m.label}</dd></div>)}</dl>
              )}
              <a class="btn btn-primary btn-small" href={`/case-studies/${c.slug}/`}>Read the {c.name} case study</a>
            </article>
          ))}
        </div>
      </Section>
    )
  }
  {
    t.faqs && t.faqs.length > 0 && (
      <Section eyebrow="FAQ" title="Common *questions*">
        <div class="faq">{t.faqs.map((f) => <details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div>
      </Section>
    )
  }
  {
    linked.length > 0 && (
      <Section tint title="Related *services*">
        <ul class="chips chips-large article">{linked.map((e) => <li><a href={`/${e.slug}/`}>{e.title}</a></li>)}</ul>
      </Section>
    )
  }
  <Closing title={`Building in ${t.name.toLowerCase()}?`} text="Tell us what you are building. A senior engineer replies within 24 hours." />
</Base>
