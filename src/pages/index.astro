---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Diagram from '../components/Diagram.astro';
import Icon from '../components/Icon.astro';
import StatsBand from '../components/StatsBand.astro';
import BookingForm from '../components/BookingForm.astro';
import Proof from '../components/Proof.astro';
import { site, pages, services, offers, cases, cta, websiteSchema, pickCases, fmt } from '../lib/content.js';

const home = pages.home;
const pad = (n) => String(n).padStart(2, '0');
const clients = cases;
const marquee = [...clients, ...clients];
const featured = pickCases(home.featuredCases);
const host = (url) => (url ? new URL(url).hostname : '');
---

<Base title={home.metaTitle} description={home.metaDescription} diagrams home form schema={[websiteSchema]}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="badge">{site.badge}</p>
        <h1 set:html={fmt(home.heroTitle)} />
        <p class="lede">{home.heroIntro}</p>
        <div class="actions">
          <a class="btn btn-primary" href={cta.href}>{cta.label}</a>
          <a class="btn btn-ghost" href="/case-studies/">{home.heroSecondaryLabel}</a>
        </div>
        <ul class="proofline">{site.heroProof.map((p) => <li>{p}</li>)}</ul>
      </div>
      <Diagram
        id="agent"
        compact
        autorun
        caption="A user request passes through tenant scoping, retrieval, orchestration, guardrails and a confidence check before a verified action is written back and logged."
      />
    </div>
  </section>

  <section class="strip" aria-label="Clients">
    <p>{site.clientsLabel}</p>
    <div class="marquee">
      <ul>
        {marquee.map((c, i) => <li aria-hidden={i >= clients.length ? 'true' : undefined}>{c.logo ? <img src={c.logo} alt={c.name} width={c.logoWidth} height={c.logoHeight} /> : c.name}</li>)}
      </ul>
    </div>
  </section>

  <Section id="services" eyebrow="Services" title={home.servicesTitle} intro={home.servicesIntro}>
    <ol class="svc-grid">
      {
        services.map((s, i) => (
          <li class="svc-card">
            <Icon name={s.slug} />
            <span class="svc-n">{pad(i + 1)} / {s.stage}</span>
            <h3><a href={`/${s.slug}/`}>{s.title}</a></h3>
            <p class="svc-lead">{s.card.lead}</p>
            <p>{s.card.text}</p>
            <ul class="chips">{s.card.tags.map((t) => <li>{t}</li>)}</ul>
            <span class="more">Learn more</span>
            <span class="svc-ghost" aria-hidden="true">{i + 1}</span>
          </li>
        ))
      }
      <li class="svc-card is-offers">
        <span class="svc-n">Fixed scope</span>
        <h3>{home.offersPrompt}</h3>
        <ul>
          {offers.map((o) => <li><a href={`/${o.slug}/`}>{o.title}</a></li>)}
        </ul>
      </li>
    </ol>
  </Section>

  <StatsBand />

  <Section id="process" eyebrow="Process" center title={home.processTitle} intro={home.processIntro}>
    <ol class="phases">
      {home.process.map((p) => <li class="phase"><span class="phase-label">{p.title}</span><h3>{p.lead || p.title}</h3><p>{p.text}</p></li>)}
    </ol>
    <p class="section-foot"><a class="btn btn-ghost" href="/process/">See the full process</a></p>
  </Section>

  <Section id="work" eyebrow="Case studies" split title={home.workTitle} intro={home.workIntro}>
    <div class="case-rows">
      {
        featured.map((c, i) => (
          <article class="case-row">
            <a class="case-visual" href={`/case-studies/${c.slug}/`} tabindex="-1" aria-hidden="true">
              <span class="case-visual-name">{c.name}</span>
              <span class="case-visual-panel">
                {c.logo && <img class="case-visual-logo" src={c.logo} alt="" width={c.logoWidth} height={c.logoHeight} loading="lazy" />}
                <span>{c.liveUrl ? `Live at ${host(c.liveUrl)}` : c.industry}</span>
                <ul class="chips">{(c.services || c.stack).slice(0, 4).map((t) => <li>{t}</li>)}</ul>
              </span>
            </a>
            <div>
              <p class="case-eyebrow">{pad(i + 1)} / {c.industry}</p>
              <h3><a href={`/case-studies/${c.slug}/`}>{c.headline}</a></h3>
              <p class="case-summary">{c.overview}</p>
              <div class="metrics">
                {c.metrics.map((m) => <p class="metric"><strong>{m.value}</strong><span>{m.label}</span></p>)}
              </div>
              <a class="more" href={`/case-studies/${c.slug}/`}>Read the {c.name} case study</a>
            </div>
          </article>
        ))
      }
    </div>
    <p class="section-foot"><a class="btn btn-ghost" href="/case-studies/">View all case studies</a></p>
  </Section>

  <BookingForm />
  <Proof />
</Base>
