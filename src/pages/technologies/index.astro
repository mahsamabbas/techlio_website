---
import Base from '../../layouts/Base.astro';
import Closing from '../../components/Closing.astro';
import { technologies, breadcrumbSchema } from '../../lib/content.js';
---

<Base
  title="Technologies We Build With: n8n, LangChain, Claude, OpenAI, Python, React, AWS"
  description="The tools Techlio's engineers use to build AI agents, automations and SaaS products, with real client projects for each."
  schema={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Technologies', path: '/technologies/' }])]}
>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Technologies</span>
      <h1>The tools we build with, <span class="accent">and what we build with them.</span></h1>
      <p class="lede">We choose the stack for the problem, not the other way round. These are the technologies our engineers use most, each with client work behind it.</p>
      <div class="insight-list">
        {
          technologies.map((t) => (
            <article class="insight-card">
              <h2><a href={`/technologies/${t.slug}/`}>{t.name}</a></h2>
              <p>{t.description}</p>
              <span class="more">How we use {t.name}</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <Closing title="Not sure which stack fits?" text="Bring the problem to a scoping call. A senior engineer will recommend an approach and explain the trade-offs." />
</Base>
