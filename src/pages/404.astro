---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist on techlio.co.">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>That page <span class="accent">is not here.</span></h1>
      <p class="lede">The link may be old or mistyped. Start again from the home page, or go straight to booking a call.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/">Go to the home page</a>
        <a class="btn btn-ghost" href="/contact/#book">Book a technical scoping call</a>
      </div>
    </div>
  </section>
</Base>
