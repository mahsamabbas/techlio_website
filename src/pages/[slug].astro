---
// Service pages and fixed-scope offer pages, generated from content/services and content/offers.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Steps from '../components/Steps.astro';
import Blocks from '../components/Blocks.astro';
import CaseCards from '../components/CaseCards.astro';
import Closing from '../components/Closing.astro';
import { services, offers } from '../lib/content.js';

export function getStaticPaths() {
  return [
    ...services.map((entry) => ({ params: { slug: entry.slug }, props: { kind: 'service', entry } })),
    ...offers.map((entry) => ({ params: { slug: entry.slug }, props: { kind: 'offer', entry } })),
  ];
}

const { kind, entry: e } = Astro.props;
const has = (list) => Array.isArray(list) && list.length > 0;
---

<Base title={e.title} description={e.description} diagrams={Boolean(e.diagram)}>
  {
    kind === 'service' ? (
      <>
        <PageHero
          back={{ href: '/#services', label: 'all services' }}
          title={e.h1}
          intro={e.intro}
          secondary={{ href: '/case-studies/', label: 'See shipped work' }}
          diagram={e.diagram}
          caption={e.caption}
        />
        <Section title={e.offerTitle} intro={e.offerIntro}>
          <Steps items={e.offerings} cols={4} />
        </Section>
        {has(e.cases) && (
          <Section tint title="Related client work">
            <CaseCards slugs={e.cases} />
          </Section>
        )}
        <Section title={e.whyTitle}>
          <Blocks items={e.why} />
        </Section>
      </>
    ) : (
      <>
        <PageHero
          kicker={e.kicker}
          title={e.h1}
          intro={e.intro}
          primaryLabel={e.primaryLabel}
          secondary={{ href: '/process/', label: 'How we work' }}
          diagram={e.diagram}
          caption={e.caption}
        />
        {has(e.audience) && (
          <Section title={e.audienceTitle} intro={e.audienceIntro}>
            <Blocks items={e.audience} />
          </Section>
        )}
        {has(e.pains) && (
          <Section title={e.painsTitle}>
            <ul class="pains">{e.pains.map((p) => <li>{p}</li>)}</ul>
          </Section>
        )}
        <Section tint title={e.stepsTitle} intro={e.stepsIntro}>
          <Steps items={e.steps} cols={4} />
        </Section>
        {has(e.deliverables) && (
          <Section title={e.deliverablesTitle}>
            <ul class="ticks ticks-grid">{e.deliverables.map((x) => <li>{x}</li>)}</ul>
          </Section>
        )}
        <Section tint={has(e.deliverables)} title={e.whyTitle}>
          <Blocks items={e.why} />
        </Section>
        {has(e.cases) && (
          <Section tint={!has(e.deliverables)} title="Related client work">
            <CaseCards slugs={e.cases} />
          </Section>
        )}
      </>
    )
  }
  <Closing title={e.closeTitle} text={e.closeText} />
</Base>
