---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Blocks from '../../components/Blocks.astro';
import CaseCards from '../../components/CaseCards.astro';
import Closing from '../../components/Closing.astro';
import { cases, breadcrumbSchema } from '../../lib/content.js';

export function getStaticPaths() {
  return cases.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const related = cases.filter((x) => x.slug !== c.slug).slice(0, 2).map((x) => x.slug);
const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Case studies', path: '/case-studies/' },
    { name: c.name, path: `/case-studies/${c.slug}/` },
  ]),
];
const has = (list) => Array.isArray(list) && list.length > 0;
const host = c.liveUrl ? new URL(c.liveUrl).hostname : '';
---

<Base title={`${c.name} case study: ${c.categories[0]}`} description={`${c.headline}. A Techlio case study.`} schema={schema}>
  <section class="page-hero">
    <div class="wrap">
      <a class="back" href="/case-studies/">All case studies</a>
      {c.logo && <img class="case-logo" src={c.logo} alt={`${c.name} logo`} width={c.logoWidth} height={c.logoHeight} />}
      <span class="eyebrow">{c.industry}</span>
      <h1>{c.headline}</h1>
      <p class="lede">{c.overview}</p>
      <ul class="chips chips-large case-services">{(c.services || []).map((t) => <li>{t}</li>)}</ul>
      <div class="case-hero-metrics">
        {c.metrics.map((m) => <div class="info-card"><strong>{m.value}</strong><p>{m.label}</p></div>)}
      </div>
      <dl class="facts">
        <div><dt>Client</dt><dd>{c.name}</dd></div>
        {c.duration && <div><dt>Duration</dt><dd>{c.duration}</dd></div>}
        {has(c.team) && <div><dt>Team</dt><dd>{c.team.join(', ')}</dd></div>}
        {host && <div><dt>Live</dt><dd><a href={c.liveUrl} rel="noopener">{host}</a></dd></div>}
      </dl>
    </div>
  </section>

  {has(c.challenges) && (
    <Section eyebrow="Challenge" tint title="The *challenge*">
      <Blocks items={c.challenges} cols={2} />
    </Section>
  )}

  <Section eyebrow="Solution" title="What *we built*">
    <Blocks items={c.solutions} cols={2} />
    {has(c.stack) && <h3 class="sub">Stack</h3>}
    {has(c.stack) && <ul class="chips chips-large">{c.stack.map((x) => <li>{x}</li>)}</ul>}
  </Section>

  {has(c.results) && (
    <Section eyebrow="Results" tint title="The *results*">
      <ul class="ticks ticks-grid ticks-2">{c.results.map((x) => <li>{x}</li>)}</ul>
    </Section>
  )}

  <Closing title="Have a similar problem?" text="Tell us where you are and we will share how we would approach it." />

  <Section eyebrow="More work" title="More *case studies*">
    <CaseCards slugs={related} />
  </Section>
</Base>
