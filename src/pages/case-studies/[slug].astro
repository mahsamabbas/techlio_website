---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Blocks from '../../components/Blocks.astro';
import CaseCards from '../../components/CaseCards.astro';
import Closing from '../../components/Closing.astro';
import { cases } from '../../lib/content.js';

export function getStaticPaths() {
  return cases.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const related = cases.filter((x) => x.slug !== c.slug).slice(0, 2).map((x) => x.slug);
const host = c.liveUrl ? new URL(c.liveUrl).hostname : '';
---

<Base title={`${c.name} case study`} description={`${c.headline}. A Techlio case study.`}>
  <section class="page-hero case">
    <div class="wrap">
      <a class="back" href="/case-studies/">Back to all case studies</a>
      <p class="case-tag">{c.industry}</p>
      <h1>{c.headline}</h1>
      <p class="lede">{c.overview}</p>
      <p class="chips-inline">{c.categories.join(', ')}</p>
      <div class="metric-row">
        {c.metrics.map((m) => <p class="case-headline-metric"><strong>{m.value}</strong> {m.label}</p>)}
      </div>
      <dl class="facts case-facts">
        <div><dt>Client</dt><dd>{c.name}</dd></div>
        <div><dt>Duration</dt><dd>{c.duration}</dd></div>
        <div><dt>Team</dt><dd>{c.team.join(', ')}</dd></div>
        {host && <div><dt>Live</dt><dd><a href={c.liveUrl} rel="noopener">{host}</a></dd></div>}
      </dl>
    </div>
  </section>

  <Section tint title="The challenge">
    <Blocks items={c.challenges} cols={2} />
  </Section>

  <Section title="What we built">
    <Blocks items={c.solutions} cols={2} />
    <h3 class="case-sub">Stack</h3>
    <ul class="chips chips-large">{c.stack.map((x) => <li>{x}</li>)}</ul>
  </Section>

  <Section tint title="Results">
    <ul class="ticks ticks-grid ticks-2">{c.results.map((x) => <li>{x}</li>)}</ul>
  </Section>

  <Closing title="Have a similar problem?" text="Tell us where you are and we will share how we would approach it." />

  <Section title="More case studies">
    <CaseCards slugs={related} />
  </Section>
</Base>
