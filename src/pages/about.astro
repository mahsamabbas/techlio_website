---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Blocks from '../components/Blocks.astro';
import StatsBand from '../components/StatsBand.astro';
import Closing from '../components/Closing.astro';
import { site, pages, fmt } from '../lib/content.js';
const p = pages.about;
---

<Base title="About Techlio" description={p.metaDescription}>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">About</span>
      <h1 set:html={fmt(p.heroTitle)} />
      <p class="lede">{p.heroIntro}</p>
    </div>
  </section>

  <StatsBand />

  <Section eyebrow="Purpose" title={p.purposeTitle}>
    <Blocks items={p.purpose} cols={2} />
  </Section>

  <Section eyebrow="Values" tint title={p.valuesTitle}>
    <Blocks items={p.values} />
  </Section>

  <Section eyebrow="Offices" title={p.officesTitle} intro={`Two offices, with delivery across the ${site.regions}.`}>
    <div class="cards cards-2">
      {site.offices.map((o) => <div class="info-card"><h3>{o.country}</h3><address>{o.address}</address></div>)}
    </div>
    <h3 class="sub">Platforms</h3>
    <ul class="chips chips-large">{site.platforms.map((x) => <li>{x}</li>)}</ul>
    <h3 class="sub">Industries</h3>
    <ul class="chips chips-large">{site.industries.map((x) => <li>{x}</li>)}</ul>
    <p class="note">Want to join the team? <a href={site.careersUrl}>See open roles</a>.</p>
  </Section>

  <Closing title={p.closeTitle} text={p.closeText} />
</Base>
